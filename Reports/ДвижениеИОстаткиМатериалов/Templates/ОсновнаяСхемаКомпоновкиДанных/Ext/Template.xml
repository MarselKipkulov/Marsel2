		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
    НАЧАЛОПЕРИОДА(Движения.Период, ДЕНЬ) КАК ДатаОтбора,
    Движения.Период КАК Дата,
    Движения.Регистратор КАК Документ,
    Движения.Склад КАК Склад,
    Движения.Материал КАК Материал,
    Материалы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
    Материалы.КатегорияМатериала КАК КатегорияМатериала,
    Движения.ВидДвижения КАК ВидДвижения,

    ВЫБОР
        КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
            ТОГДА Движения.Количество
        ИНАЧЕ 0
    КОНЕЦ КАК ПриходКоличество,

    ВЫБОР
        КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
            ТОГДА Движения.Количество
        ИНАЧЕ 0
    КОНЕЦ КАК РасходКоличество,

    ВЫБОР
        КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
            ТОГДА Движения.Количество
        ИНАЧЕ -Движения.Количество
    КОНЕЦ КАК ОстатокКоличество,

    ВЫБОР
        КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
            ТОГДА Движения.Сумма
        ИНАЧЕ 0
    КОНЕЦ КАК ПриходСумма,

    ВЫБОР
        КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
            ТОГДА Движения.Сумма
        ИНАЧЕ 0
    КОНЕЦ КАК РасходСумма,

    ВЫБОР
        КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
            ТОГДА Движения.Сумма
        ИНАЧЕ -Движения.Сумма
    КОНЕЦ КАК ОстатокСумма

ИЗ
    РегистрНакопления.РегистрМатериалов КАК Движения
        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Материалы КАК Материалы
        ПО Движения.Материал = Материалы.Ссылка

ГДЕ
    Движения.Активность</query>
