Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	ЗаполнитьПараметрыОтчетаПоУмолчанию();

КонецПроцедуры


Процедура ЗаполнитьПараметрыОтчетаПоУмолчанию()

	Настройки = КомпоновщикНастроек.Настройки;

	УстановитьПараметрЕслиНеЗаполнен(
		Настройки,
		"ДатаНачала",
		Дата(1, 1, 1, 0, 0, 0)
	);

	УстановитьПараметрЕслиНеЗаполнен(
		Настройки,
		"ДатаОкончания",
		Дата(3999, 12, 31, 23, 59, 59)
	);

	УстановитьПараметрЕслиНеЗаполнен(
		Настройки,
		"ВидОперацииОтбор",
		"Все"
	);

КонецПроцедуры


Процедура УстановитьПараметрЕслиНеЗаполнен(Настройки, ИмяПараметра, ЗначениеПоУмолчанию)

	ПараметрСКД = Новый ПараметрКомпоновкиДанных(ИмяПараметра);

	ЗначениеПараметра = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрСКД);

	Если ЗначениеПараметра = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеПараметра.Использование Тогда

		ЗначениеПараметра.Использование = Истина;
		ЗначениеПараметра.Значение = ЗначениеПоУмолчанию;

	ИначеЕсли Не ЗначениеЗаполнено(ЗначениеПараметра.Значение) Тогда

		ЗначениеПараметра.Значение = ЗначениеПоУмолчанию;

	КонецЕсли;

КонецПроцедуры