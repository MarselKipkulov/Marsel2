		<query>ВЫБРАТЬ
    КОНЕЦПЕРИОДА(&amp;ДатаОкончания, ДЕНЬ) КАК ДатаОтбора,
    NULL КАК Дата,
    "Остаток наличных" КАК ВидОперации,
    NULL КАК Документ,
    0 КАК Приход,
    0 КАК Расход,
    ЕСТЬNULL(СУММА(ОстаткиНаличных.СуммаОстаток), 0) КАК Остаток,
    2 КАК ПорядокСтроки

ИЗ
    РегистрНакопления.ОстаткиНаличных.Остатки(
        КОНЕЦПЕРИОДА(&amp;ДатаОкончания, ДЕНЬ),
    ) КАК ОстаткиНаличных

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
    КОНЕЦПЕРИОДА(&amp;ДатаОкончания, ДЕНЬ) КАК ДатаОтбора,
    NULL КАК Дата,
    "Остаток безналичных" КАК ВидОперации,
    NULL КАК Документ,
    0 КАК Приход,
    0 КАК Расход,
    ЕСТЬNULL(СУММА(ОстаткиБезналичных.СуммаОстаток), 0) КАК Остаток,
    2 КАК ПорядокСтроки

ИЗ
    РегистрНакопления.ОстаткиБезналичных.Остатки(
        КОНЕЦПЕРИОДА(&amp;ДатаОкончания, ДЕНЬ),
    ) КАК ОстаткиБезналичных

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
    НАЧАЛОПЕРИОДА(Наличные.Период, ДЕНЬ) КАК ДатаОтбора,
    Наличные.Период КАК Дата,

    ВЫБОР
        КОГДА Наличные.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
            ТОГДА "Поступление наличных"
        ИНАЧЕ "Расход наличных"
    КОНЕЦ КАК ВидОперации,

    Наличные.Регистратор КАК Документ,

    ВЫБОР
        КОГДА Наличные.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
            ТОГДА Наличные.Сумма
        ИНАЧЕ 0
    КОНЕЦ КАК Приход,

    ВЫБОР
        КОГДА Наличные.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
            ТОГДА Наличные.Сумма
        ИНАЧЕ 0
    КОНЕЦ КАК Расход,

    0 КАК Остаток,
    1 КАК ПорядокСтроки

ИЗ
    РегистрНакопления.ОстаткиНаличных КАК Наличные

ГДЕ
    Наличные.Активность
    И Наличные.Период МЕЖДУ &amp;ДатаНачала И КОНЕЦПЕРИОДА(&amp;ДатаОкончания, ДЕНЬ)
    И (
        &amp;ВидОперацииОтбор = "Все"
        ИЛИ &amp;ВидОперацииОтбор = ""
        ИЛИ (
            &amp;ВидОперацииОтбор = "Поступление наличных"
            И Наличные.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
        )
        ИЛИ (
            &amp;ВидОперацииОтбор = "Расход наличных"
            И Наличные.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
        )
    )

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
    НАЧАЛОПЕРИОДА(Безналичные.Период, ДЕНЬ) КАК ДатаОтбора,
    Безналичные.Период КАК Дата,

    ВЫБОР
        КОГДА Безналичные.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
            ТОГДА "Поступление безналичных"
        ИНАЧЕ "Расход безналичных"
    КОНЕЦ КАК ВидОперации,

    Безналичные.Регистратор КАК Документ,

    ВЫБОР
        КОГДА Безналичные.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
            ТОГДА Безналичные.Сумма
        ИНАЧЕ 0
    КОНЕЦ КАК Приход,

    ВЫБОР
        КОГДА Безналичные.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
            ТОГДА Безналичные.Сумма
        ИНАЧЕ 0
    КОНЕЦ КАК Расход,

    0 КАК Остаток,
    1 КАК ПорядокСтроки

ИЗ
    РегистрНакопления.ОстаткиБезналичных КАК Безналичные

ГДЕ
    Безналичные.Активность
    И Безналичные.Период МЕЖДУ &amp;ДатаНачала И КОНЕЦПЕРИОДА(&amp;ДатаОкончания, ДЕНЬ)
    И (
        &amp;ВидОперацииОтбор = "Все"
        ИЛИ &amp;ВидОперацииОтбор = ""
        ИЛИ (
            &amp;ВидОперацииОтбор = "Поступление безналичных"
            И Безналичные.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
        )
        ИЛИ (
            &amp;ВидОперацииОтбор = "Расход безналичных"
            И Безналичные.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
        )
    )</query>
