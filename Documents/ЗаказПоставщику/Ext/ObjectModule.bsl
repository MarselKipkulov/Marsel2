// Процедура ПередЗаписью выполняется перед записью документа.
// Она нужна, чтобы перед сохранением документа пересчитать суммы
// и автоматически установить статус заказа поставщику.
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	// Создаем переменную для хранения общей суммы документа.
	Итог = 0;

	// Перебираем все строки табличной части "Материалы".
	Для Каждого Стр Из Материалы Цикл
		
		// Проверяем, заполнен ли материал в текущей строке.
		// Если материал не выбран, такую строку не учитываем в сумме документа.
		Если Не ЗначениеЗаполнено(Стр.Материал) Тогда
			
			// Для пустой строки устанавливаем стоимость 0,
			// чтобы она не влияла на итоговую сумму.
			Стр.Стоимость = 0;
			
			// Переходим к следующей строке табличной части.
			Продолжить;
			
		КонецЕсли;
		
		// Рассчитываем стоимость строки:
		// количество материала умножается на цену договора.
		Стр.Стоимость = Стр.Количество * Стр.ЦенаДоговора;
		
		// Добавляем стоимость текущей строки к общей сумме документа.
		Итог = Итог + Стр.Стоимость;

	КонецЦикла;

	// Записываем рассчитанную сумму в реквизит документа "ОбщаяСумма".
	ОбщаяСумма = Итог;

	// Если статус заказа еще не заполнен,
	// автоматически устанавливаем начальный статус "Новый".
	Если Не ЗначениеЗаполнено(Статус) Тогда
		Статус = Перечисления.СтатусЗаказаПоставщику.Новый;
	КонецЕсли;

	// Проверяем, выполняется ли именно проведение документа.
	// При обычной записи статус менять на "ВРаботе" не нужно.
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		// Если заказ был новым, то при проведении переводим его в работу.
		Если Статус = Перечисления.СтатусЗаказаПоставщику.Новый Тогда
			Статус = Перечисления.СтатусЗаказаПоставщику.ВРаботе;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры