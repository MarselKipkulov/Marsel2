// Процедура выполняется на сервере при создании формы.
// Здесь сразу скрываем Кассу и Банковский счет еще до показа формы пользователю.
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Элементы.Касса.Видимость = Ложь;
	Элементы.БанковскийСчет.Видимость = Ложь;

КонецПроцедуры


// Процедура выполняется на клиенте при открытии формы.
// Дополнительно скрываем/показываем поля оплаты при открытии.
&НаКлиенте
Процедура ПриОткрытии(Отказ)

	УправлениеВидимостьюОплаты();

КонецПроцедуры


// Процедура выполняется на клиенте.
// Она срабатывает, когда в табличной части "Материалы" изменили материал.
&НаКлиенте
Процедура МатериалыМатериалПриИзменении(Элемент)

	ПересчитатьСтрокуМатериалов();
	
КонецПроцедуры


// Процедура выполняется на клиенте.
// Она срабатывает, когда в строке табличной части изменили вид цены.
&НаКлиенте
Процедура МатериалыВидЦеныПриИзменении(Элемент)

	ПересчитатьСтрокуМатериалов();
	
КонецПроцедуры


// Процедура выполняется на клиенте.
// Она срабатывает, когда пользователь изменил количество материала.
&НаКлиенте
Процедура МатериалыКоличествоПриИзменении(Элемент)

	Стр = Элементы.Материалы.ТекущиеДанные;
	
	Если Стр = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Стр.Стоимость = Стр.Количество * Стр.ЦенаДоговора;
	
	ПересчитатьСумму();

КонецПроцедуры


// Процедура выполняется на клиенте.
// Она срабатывает, когда пользователь вручную изменил цену договора.
&НаКлиенте
Процедура МатериалыЦенаДоговораПриИзменении(Элемент)

	Стр = Элементы.Материалы.ТекущиеДанные;
	
	Если Стр = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Стр.Стоимость = Стр.Количество * Стр.ЦенаДоговора;
	
	ПересчитатьСумму();

КонецПроцедуры


// Процедура срабатывает при изменении способа оплаты.
// Сначала скрывает оба поля, потом показывает только нужное.
&НаКлиенте
Процедура СпособОплатыПриИзменении(Элемент)

	УправлениеВидимостьюОплаты();

КонецПроцедуры


// Главная процедура управления видимостью полей оплаты.
&НаКлиенте
Процедура УправлениеВидимостьюОплаты()

	// Сначала всегда скрываем оба поля.
	Элементы.Касса.Видимость = Ложь;
	Элементы.БанковскийСчет.Видимость = Ложь;

	// Если способ оплаты не выбран — оба поля остаются скрытыми.
	Если Не ЗначениеЗаполнено(Объект.СпособОплаты) Тогда
		Объект.Касса = Неопределено;
		Объект.БанковскийСчет = Неопределено;
		Возврат;
	КонецЕсли;

	// Наличная оплата — показываем только кассу.
	Если Объект.СпособОплаты = ПредопределенноеЗначение("Перечисление.СпособОплаты.Наличная") Тогда
		
		Элементы.Касса.Видимость = Истина;
		Элементы.БанковскийСчет.Видимость = Ложь;
		
		Объект.БанковскийСчет = Неопределено;

	// Безналичная оплата — показываем только банковский счет.
	ИначеЕсли Объект.СпособОплаты = ПредопределенноеЗначение("Перечисление.СпособОплаты.Безналичная") Тогда
		
		Элементы.Касса.Видимость = Ложь;
		Элементы.БанковскийСчет.Видимость = Истина;
		
		Объект.Касса = Неопределено;

	// Онлайн-оплата — тоже показываем только банковский счет.
	ИначеЕсли Объект.СпособОплаты = ПредопределенноеЗначение("Перечисление.СпособОплаты.Онлайн") Тогда
		
		Элементы.Касса.Видимость = Ложь;
		Элементы.БанковскийСчет.Видимость = Истина;
		
		Объект.Касса = Неопределено;

	Иначе
		
		Элементы.Касса.Видимость = Ложь;
		Элементы.БанковскийСчет.Видимость = Ложь;
		
		Объект.Касса = Неопределено;
		Объект.БанковскийСчет = Неопределено;

	КонецЕсли;

КонецПроцедуры


// Процедура пересчитывает текущую строку табличной части "Материалы".
&НаКлиенте
Процедура ПересчитатьСтрокуМатериалов()

	Стр = Элементы.Материалы.ТекущиеДанные;
	
	Если Стр = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Стр.Материал)
		И ЗначениеЗаполнено(Стр.ВидЦены) Тогда
		
		Стр.ЦенаДоговора = ПолучитьЦенуМатериала(
			Стр.Материал,
			Стр.ВидЦены,
			Объект.Дата);
			
	Иначе
		
		Стр.ЦенаДоговора = 0;
		
	КонецЕсли;

	Стр.Стоимость = Стр.Количество * Стр.ЦенаДоговора;
	
	ПересчитатьСумму();

КонецПроцедуры


// Процедура пересчитывает общую сумму документа.
&НаКлиенте
Процедура ПересчитатьСумму()

	Итог = 0;

	Для Каждого Стр Из Объект.Материалы Цикл
		
		Итог = Итог + Стр.Стоимость;
		
	КонецЦикла;

	Объект.ОбщаяСумма = Итог;

КонецПроцедуры


// Функция получает цену материала из регистра сведений "ЦеныМатериалов".
&НаСервереБезКонтекста
Функция ПолучитьЦенуМатериала(Материал, ВидЦены, ДатаДок)

	Если Не ЗначениеЗаполнено(Материал) Или Не ЗначениеЗаполнено(ВидЦены) Тогда
		Возврат 0;
	КонецЕсли;

	Запрос = Новый Запрос;

	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЦеныМатериаловСрезПоследних.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныМатериалов.СрезПоследних(
	|		&Дата,
	|		Материал = &Материал
	|		И ВидЦены = &ВидЦены
	|	) КАК ЦеныМатериаловСрезПоследних";

	Запрос.УстановитьПараметр("Дата", КонецДня(ДатаДок));
	Запрос.УстановитьПараметр("Материал", Материал);
	Запрос.УстановитьПараметр("ВидЦены", ВидЦены);

	Рез = Запрос.Выполнить();

	Если Не Рез.Пустой() Тогда
		
		Выб = Рез.Выбрать();
		
		Если Выб.Следующий() Тогда
			Возврат Выб.Цена;
		КонецЕсли;
		
	КонецЕсли;

	Возврат 0;

КонецФункции	