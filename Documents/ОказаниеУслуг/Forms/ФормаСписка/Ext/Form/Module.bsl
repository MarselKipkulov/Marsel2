&НаКлиенте
Процедура ПакетноеЗакрытие(Команда)

	МассивСсылок = ПолучитьМассивВыделенныхДокументов();

	Если МассивСсылок.Количество() = 0 Тогда
		Сообщить("Не выбраны документы для пакетного закрытия.");
		Возврат;
	КонецЕсли;

	Результат = ПакетноеЗакрытиеНаСервере(МассивСсылок);
	Сообщить(Результат);

	ОбновитьСписок();

КонецПроцедуры


&НаКлиенте
Процедура ПакетноПровестиЗакрытые(Команда)

	МассивСсылок = ПолучитьМассивВыделенныхДокументов();

	Если МассивСсылок.Количество() = 0 Тогда
		Сообщить("Не выбраны документы для пакетного проведения.");
		Возврат;
	КонецЕсли;

	Результат = ПакетноПровестиЗакрытыеНаСервере(МассивСсылок);
	Сообщить(Результат);

	ОбновитьСписок();

КонецПроцедуры


&НаКлиенте
Функция ПолучитьМассивВыделенныхДокументов()

	Результат = Новый Массив;

	ЭлементСписка = Элементы.Найти("Список");

	Если ЭлементСписка = Неопределено Тогда
		Сообщить("Не найден элемент формы 'Список'. Проверь имя элемента списка на форме.");
		Возврат Результат;
	КонецЕсли;

	Попытка

		ВыделенныеСтроки = ЭлементСписка.ВыделенныеСтроки;

		Если ВыделенныеСтроки <> Неопределено Тогда

			Для Каждого ЭлементВыделения Из ВыделенныеСтроки Цикл
				ДобавитьСсылкуДокументаВМассив(Результат, ЭлементВыделения);
			КонецЦикла;

		КонецЕсли;

	Исключение
	КонецПопытки;

	Если Результат.Количество() = 0 Тогда

		Попытка
			ТекущаяСтрока = ЭлементСписка.ТекущаяСтрока;
			ДобавитьСсылкуДокументаВМассив(Результат, ТекущаяСтрока);
		Исключение
			Сообщить("Не удалось получить текущую строку списка.");
		КонецПопытки;

	КонецЕсли;

	Возврат Результат;

КонецФункции


&НаКлиенте
Процедура ДобавитьСсылкуДокументаВМассив(МассивСсылок, ЗначениеСтроки)

	Если ЗначениеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(ЗначениеСтроки) = Тип("ДокументСсылка.ОказаниеУслуг") Тогда

		Если ЗначениеЗаполнено(ЗначениеСтроки) Тогда
			МассивСсылок.Добавить(ЗначениеСтроки);
		КонецЕсли;

		Возврат;

	КонецЕсли;

	Попытка

		Если ЗначениеЗаполнено(ЗначениеСтроки.Ссылка) Тогда
			МассивСсылок.Добавить(ЗначениеСтроки.Ссылка);
		КонецЕсли;

	Исключение
	КонецПопытки;

КонецПроцедуры


&НаКлиенте
Процедура ОбновитьСписок()

	ЭлементСписка = Элементы.Найти("Список");

	Если ЭлементСписка <> Неопределено Тогда

		Попытка
			ЭлементСписка.Обновить();
		Исключение
		КонецПопытки;

	КонецЕсли;

КонецПроцедуры


&НаСервере
Функция ПакетноеЗакрытиеНаСервере(МассивСсылок) Экспорт

	КоличествоИзменено = 0;
	КоличествоУжеЗакрыто = 0;
	КоличествоИсправлено = 0;
	КоличествоПропущено = 0;
	КоличествоОшибок = 0;

	ТекстПропусков = "";
	ТекстОшибок = "";

	Для Каждого СсылкаДок Из МассивСсылок Цикл

		Если Не ЗначениеЗаполнено(СсылкаДок) Тогда
			КоличествоПропущено = КоличествоПропущено + 1;
			ТекстПропусков = ДобавитьСтрокуСообщения(ТекстПропусков, "Пустая ссылка на документ.");
			Продолжить;
		КонецЕсли;

		Попытка

			Если ТипЗнч(СсылкаДок) <> Тип("ДокументСсылка.ОказаниеУслуг") Тогда
				КоличествоПропущено = КоличествоПропущено + 1;
				ТекстПропусков = ДобавитьСтрокуСообщения(
					ТекстПропусков,
					"Пропущен не тот тип документа: " + Строка(СсылкаДок));
				Продолжить;
			КонецЕсли;

			ДокОбъект = СсылкаДок.ПолучитьОбъект();

			Если ДокОбъект.СтатусУслуги = Перечисления.СтатусУслуги.Завершен Тогда
				КоличествоУжеЗакрыто = КоличествоУжеЗакрыто + 1;
				Продолжить;
			КонецЕсли;

			// Исправляем неправильное состояние:
			// документ проведен, но статус еще Запланирован.
			Если ДокОбъект.Проведен
				И ДокОбъект.СтатусУслуги = Перечисления.СтатусУслуги.Запланирован Тогда

				ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				ДокОбъект.СтатусУслуги = Перечисления.СтатусУслуги.Завершен;
				ДокОбъект.Записать();

				КоличествоИсправлено = КоличествоИсправлено + 1;
				Продолжить;

			КонецЕсли;

			Если ДокОбъект.Проведен Тогда
				КоличествоПропущено = КоличествоПропущено + 1;
				ТекстПропусков = ДобавитьСтрокуСообщения(
					ТекстПропусков,
					"Документ уже проведен: " + Строка(СсылкаДок));
				Продолжить;
			КонецЕсли;

			Если ДокОбъект.СтатусУслуги <> Перечисления.СтатусУслуги.Запланирован Тогда
				КоличествоПропущено = КоличествоПропущено + 1;
				ТекстПропусков = ДобавитьСтрокуСообщения(
					ТекстПропусков,
					"Документ пропущен. Текущий статус: "
					+ Строка(ДокОбъект.СтатусУслуги)
					+ ". Для закрытия нужен статус: Запланирован. Документ: "
					+ Строка(СсылкаДок));
				Продолжить;
			КонецЕсли;

			ДокОбъект.СтатусУслуги = Перечисления.СтатусУслуги.Завершен;
			ДокОбъект.Записать();

			КоличествоИзменено = КоличествоИзменено + 1;

		Исключение

			КоличествоОшибок = КоличествоОшибок + 1;

			ТекстОшибок = ДобавитьСтрокуСообщения(
				ТекстОшибок,
				"Не удалось закрыть документ: "
				+ Строка(СсылкаДок)
				+ ". Причина: "
				+ ОписаниеОшибки());

		КонецПопытки;

	КонецЦикла;

	Возврат "Пакетное закрытие завершено."
		+ Символы.ПС + "Изменено: " + Строка(КоличествоИзменено)
		+ Символы.ПС + "Исправлено неправильно проведенных: " + Строка(КоличествоИсправлено)
		+ Символы.ПС + "Уже закрыто: " + Строка(КоличествоУжеЗакрыто)
		+ Символы.ПС + "Пропущено: " + Строка(КоличествоПропущено)
		+ Символы.ПС + "Ошибок: " + Строка(КоличествоОшибок)
		+ ?(ПустаяСтрока(ТекстПропусков), "", Символы.ПС + Символы.ПС + "Причины пропуска:" + Символы.ПС + ТекстПропусков)
		+ ?(ПустаяСтрока(ТекстОшибок), "", Символы.ПС + Символы.ПС + "Ошибки:" + Символы.ПС + ТекстОшибок);

КонецФункции


&НаСервере
Функция ПакетноПровестиЗакрытыеНаСервере(МассивСсылок) Экспорт

	КоличествоПроведено = 0;
	КоличествоУжеПроведено = 0;
	КоличествоПропущено = 0;
	КоличествоОшибок = 0;

	ТекстПропусков = "";
	ТекстОшибок = "";

	Для Каждого СсылкаДок Из МассивСсылок Цикл

		Если Не ЗначениеЗаполнено(СсылкаДок) Тогда
			КоличествоПропущено = КоличествоПропущено + 1;
			ТекстПропусков = ДобавитьСтрокуСообщения(ТекстПропусков, "Пустая ссылка на документ.");
			Продолжить;
		КонецЕсли;

		Попытка

			Если ТипЗнч(СсылкаДок) <> Тип("ДокументСсылка.ОказаниеУслуг") Тогда
				КоличествоПропущено = КоличествоПропущено + 1;
				ТекстПропусков = ДобавитьСтрокуСообщения(
					ТекстПропусков,
					"Пропущен не тот тип документа: " + Строка(СсылкаДок));
				Продолжить;
			КонецЕсли;

			ДокОбъект = СсылкаДок.ПолучитьОбъект();

			Если ДокОбъект.Проведен Тогда

				Если ДокОбъект.СтатусУслуги = Перечисления.СтатусУслуги.Завершен Тогда
					КоличествоУжеПроведено = КоличествоУжеПроведено + 1;
				Иначе
					КоличествоПропущено = КоличествоПропущено + 1;
					ТекстПропусков = ДобавитьСтрокуСообщения(
						ТекстПропусков,
						"Документ уже проведен, но статус не Завершен. Сначала нажмите Пакетное закрытие: "
						+ Строка(СсылкаДок));
				КонецЕсли;

				Продолжить;

			КонецЕсли;

			Если ДокОбъект.СтатусУслуги <> Перечисления.СтатусУслуги.Завершен Тогда
				КоличествоПропущено = КоличествоПропущено + 1;
				ТекстПропусков = ДобавитьСтрокуСообщения(
					ТекстПропусков,
					"Документ пропущен. Текущий статус: "
					+ Строка(ДокОбъект.СтатусУслуги)
					+ ". Для проведения нужен статус: Завершен. Документ: "
					+ Строка(СсылкаДок));
				Продолжить;
			КонецЕсли;

			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);

			КоличествоПроведено = КоличествоПроведено + 1;

		Исключение

			КоличествоОшибок = КоличествоОшибок + 1;

			ТекстОшибок = ДобавитьСтрокуСообщения(
				ТекстОшибок,
				"Не удалось провести документ: "
				+ Строка(СсылкаДок)
				+ ". Причина: "
				+ ОписаниеОшибки());

		КонецПопытки;

	КонецЦикла;

	Возврат "Пакетное проведение завершено."
		+ Символы.ПС + "Проведено: " + Строка(КоличествоПроведено)
		+ Символы.ПС + "Уже проведено: " + Строка(КоличествоУжеПроведено)
		+ Символы.ПС + "Пропущено: " + Строка(КоличествоПропущено)
		+ Символы.ПС + "Ошибок: " + Строка(КоличествоОшибок)
		+ ?(ПустаяСтрока(ТекстПропусков), "", Символы.ПС + Символы.ПС + "Причины пропуска:" + Символы.ПС + ТекстПропусков)
		+ ?(ПустаяСтрока(ТекстОшибок), "", Символы.ПС + Символы.ПС + "Ошибки:" + Символы.ПС + ТекстОшибок);

КонецФункции


&НаСервереБезКонтекста
Функция ДобавитьСтрокуСообщения(ТекущийТекст, НоваяСтрока)

	Если ПустаяСтрока(ТекущийТекст) Тогда
		Возврат НоваяСтрока;
	Иначе
		Возврат ТекущийТекст + Символы.ПС + НоваяСтрока;
	КонецЕсли;

КонецФункции