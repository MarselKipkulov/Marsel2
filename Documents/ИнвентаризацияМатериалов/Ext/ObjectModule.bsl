// Процедура ПередЗаписью выполняется перед записью документа.
// В этом коде проверяется правильность заполнения инвентаризации:
// указан ли склад, заполнена ли табличная часть,
// нет ли отрицательных остатков, а также пересчитываются отклонения.
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	// Проверяем, указан ли склад.
	// Без склада нельзя проводить инвентаризацию,
	// потому что остатки материалов ведутся в разрезе складов.
	Если Не ЗначениеЗаполнено(Склад) Тогда
		
		// Сообщаем пользователю об ошибке.
		Сообщить("Не указан склад.");
		
		// Отменяем запись документа.
		Отказ = Истина;
		
		// Завершаем выполнение процедуры.
		Возврат;
		
	КонецЕсли;

	// Проверяем, есть ли строки в табличной части "Материалы".
	// Если строк нет, инвентаризацию записывать нельзя.
	Если Материалы.Количество() = 0 Тогда
		
		// Выводим сообщение пользователю.
		Сообщить("Табличная часть материалов не заполнена.");
		
		// Отменяем запись документа.
		Отказ = Истина;
		
		// Завершаем выполнение процедуры.
		Возврат;
		
	КонецЕсли;

	// Переменная показывает, есть ли в документе хотя бы одна строка
	// с заполненным материалом.
	ЕстьСтроки = Ложь;

	// Перебираем все строки табличной части "Материалы".
	Для Каждого СтрМатериал Из Материалы Цикл

		// Если материал в строке не заполнен,
		// такую строку пропускаем.
		Если Не ЗначениеЗаполнено(СтрМатериал.Материал) Тогда
			Продолжить;
		КонецЕсли;

		// Если материал заполнен, значит в документе есть корректная строка.
		ЕстьСтроки = Истина;

		// Проверяем остаток по учету.
		// Учетный остаток не должен быть отрицательным.
		Если СтрМатериал.ОстатокПоУчету < 0 Тогда
			
			// Выводим сообщение с названием материала.
			Сообщить(СтрШаблон(
				"Остаток по учету по материалу ""%1"" не может быть отрицательным.",
				СтрМатериал.Материал));
				
			// Отменяем запись документа.
			Отказ = Истина;
			
			// Завершаем выполнение процедуры.
			Возврат;
			
		КонецЕсли;

		// Проверяем фактический остаток.
		// Фактический остаток также не должен быть отрицательным.
		Если СтрМатериал.ОстатокФактический < 0 Тогда
			
			// Выводим сообщение с названием материала.
			Сообщить(СтрШаблон(
				"Фактический остаток по материалу ""%1"" не может быть отрицательным.",
				СтрМатериал.Материал));
				
			// Отменяем запись документа.
			Отказ = Истина;
			
			// Завершаем выполнение процедуры.
			Возврат;
			
		КонецЕсли;

		// Если учетная цена не заполнена,
		// считаем ее равной нулю.
		Если Не ЗначениеЗаполнено(СтрМатериал.ЦенаУчета) Тогда
			СтрМатериал.ЦенаУчета = 0;
		КонецЕсли;

		// Рассчитываем отклонение по количеству.
		// Формула:
		// фактический остаток минус остаток по учету.
		//
		// Если отклонение меньше 0 — это недостача.
		// Если отклонение больше 0 — это излишек.
		// Если отклонение равно 0 — расхождений нет.
		СтрМатериал.Отклонение =
			СтрМатериал.ОстатокФактический - СтрМатериал.ОстатокПоУчету;

		// Рассчитываем сумму отклонения.
		// Формула:
		// отклонение * учетная цена.
		//
		// Окр(..., 2) округляет сумму до двух знаков после запятой.
		СтрМатериал.СуммаОтклонения =
			Окр(СтрМатериал.Отклонение * СтрМатериал.ЦенаУчета, 2);

	КонецЦикла;

	// После обхода всех строк проверяем,
	// была ли найдена хотя бы одна строка с материалом.
	Если Не ЕстьСтроки Тогда
		
		// Если все строки пустые или материалов нет,
		// документ записывать нельзя.
		Сообщить("В документе нет корректных строк материалов.");
		
		// Отменяем запись документа.
		Отказ = Истина;
		
		// Завершаем выполнение процедуры.
		Возврат;
		
	КонецЕсли;

КонецПроцедуры