Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Если Сумма <= 0 Тогда
		Сообщить("Сумма пополнения должна быть больше нуля.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СпособОплаты) Тогда
		Сообщить("Не указан способ оплаты.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если СпособОплаты = Перечисления.СпособОплаты.Наличная Тогда
		
		Если Не ЗначениеЗаполнено(Касса) Тогда
			Сообщить("Для наличного пополнения необходимо указать кассу.");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		БанковскийСчет = Неопределено;
		
		Движения.ОстаткиНаличных.Записывать = Истина;

		Движение = Движения.ОстаткиНаличных.Добавить();
		Движение.Период = Дата;
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Касса = Касса;
		Движение.Сумма = Сумма;

	ИначеЕсли СпособОплаты = Перечисления.СпособОплаты.Безналичная
		Или СпособОплаты = Перечисления.СпособОплаты.Онлайн Тогда
		
		Если Не ЗначениеЗаполнено(БанковскийСчет) Тогда
			Сообщить("Для безналичного или онлайн-пополнения необходимо указать банковский счет.");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Касса = Неопределено;
		
		Движения.ОстаткиБезналичных.Записывать = Истина;

		Движение = Движения.ОстаткиБезналичных.Добавить();
		Движение.Период = Дата;
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.БанковскийСчет = БанковскийСчет;
		Движение.Сумма = Сумма;

	КонецЕсли;

КонецПроцедуры